// Meme Madness Trial — Prisma schema
// Postgres (Railway), separate project from LeagueHQ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  usernameLower String @unique // enforce case-insensitive uniqueness
  email     String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  magicTokens   MagicToken[]
  predictions   Prediction[]
  dailyStats    DailyStat[]
  auditLogs     AuditLog[]

  @@index([usernameLower])
}

model MagicToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Tournament structure ─────────────────────────────

enum TournamentDayStatus {
  SCHEDULED
  ACTIVE
  FINALIZING
  COMPLETE
}

model TournamentDay {
  id          String              @id @default(cuid())
  dayNumber   Int                 @unique // 1, 2, 3
  startsAt    DateTime
  endsAt      DateTime
  status      TournamentDayStatus @default(SCHEDULED)

  tokens      TokenLineup[]
  markets     Market[]
  dailyStats  DailyStat[]
  battle      Battle?
}

enum TokenStatus {
  PENDING
  ELIGIBLE
  VOTING
  UNDERDOG
  ALL_STAR
  ELIMINATED
  REJECTED
}

model Token {
  id            String   @id @default(cuid())
  contractAddr  String   @unique
  symbol        String
  name          String
  status        TokenStatus @default(PENDING)
  createdAt     DateTime @default(now())

  lineups       TokenLineup[]
  markets       Market[]
  battlesAsA    Battle[] @relation("BattleTokenA")
  battlesAsB    Battle[] @relation("BattleTokenB")

  @@index([status])
}

// Pre-staged by you before the trial starts. Every row for all 3 days
// exists in the DB in advance — the tick engine just reads whichever
// lineup rows match "now", it never writes new ones.
model TokenLineup {
  id              String        @id @default(cuid())
  tournamentDayId String
  tournamentDay   TournamentDay @relation(fields: [tournamentDayId], references: [id])
  tokenId         String
  token           Token         @relation(fields: [tokenId], references: [id])
  role            TokenStatus   // ALL_STAR or UNDERDOG for that day

  @@unique([tournamentDayId, tokenId])
}

// Purely computed + displayed, never mutates the lineup. The two
// Underdogs for this day are already fixed via TokenLineup; this
// just tallies their Counted Volume automatically and records who
// "won" for leaderboard/announcement purposes.
model Battle {
  id              String        @id @default(cuid())
  tournamentDayId String        @unique
  tournamentDay   TournamentDay @relation(fields: [tournamentDayId], references: [id])
  tokenAId        String
  tokenA          Token         @relation("BattleTokenA", fields: [tokenAId], references: [id])
  tokenBId        String
  tokenB          Token         @relation("BattleTokenB", fields: [tokenBId], references: [id])
  volumeA         Int           @default(0)
  volumeB         Int           @default(0)
  winnerTokenId   String?
  resolvedAt      DateTime?
}

// ── Markets & predictions ────────────────────────────

enum MarketDuration {
  ONE_MIN
  THREE_MIN
  FIVE_MIN
}

enum MarketStatus {
  SCHEDULED
  OPEN
  PREDICTIONS_CLOSED
  SETTLING
  SETTLED
  VOIDED
}

enum Outcome {
  UP
  DOWN
  PUSH
}

model Market {
  id                String         @id @default(cuid())
  tournamentDayId   String
  tournamentDay     TournamentDay  @relation(fields: [tournamentDayId], references: [id])
  tokenId           String
  token             Token          @relation(fields: [tokenId], references: [id])
  duration          MarketDuration
  status            MarketStatus   @default(SCHEDULED)

  opensAt           DateTime
  cutoffAt          DateTime
  settlesAt          DateTime

  startMarketCapUsd Decimal?       @db.Decimal(20, 2)
  endMarketCapUsd   Decimal?       @db.Decimal(20, 2)
  outcome           Outcome?

  predictions       Prediction[]

  @@index([status])
  @@index([tokenId, duration])
}

enum Direction {
  UP
  DOWN
}

model Prediction {
  id             String    @id @default(cuid())
  marketId       String
  market         Market    @relation(fields: [marketId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  direction      Direction
  stake          Int
  payout         Int?      // null until settled
  idempotencyKey String    @unique
  voided         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([userId])
  @@index([marketId])
}

// ── Stats & leaderboard persistence ──────────────────

model DailyStat {
  id              String        @id @default(cuid())
  tournamentDayId String
  tournamentDay   TournamentDay @relation(fields: [tournamentDayId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  netCreditsWon   Int           @default(0)
  predictionCount Int           @default(0)
  bestMultiple    Decimal       @default(0) @db.Decimal(10, 2)

  @@unique([tournamentDayId, userId])
  @@index([tournamentDayId, netCreditsWon])
}

// ── Audit ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}
